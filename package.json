{
  "name": "org-document-search",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Native Microsoft 365 multilingual document discovery declarative agent",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "compile": "tsp compile src/agent/main.tsp --config tspconfig.yaml",
    "stage": "node scripts/build.mjs",
    "build": "npm run compile && node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "package": "npm run build && node scripts/package.mjs",
    "package:tenant": "node scripts/tenant-package.mjs",
    "configure": "node scripts/configure.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "secrets": "node scripts/secrets.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "check": "npm run build && npm run validate && npm test && npm run package && npm run verify-package && npm run secrets"
  },
  "overrides": {
    "@microsoft/m365agentstoolkit-cli": {
      "@azure/msal-node": "7.2.0"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "@scalar/json-magic@0.13.5": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@microsoft/m365agentstoolkit-cli": "1.1.19",
    "@microsoft/typespec-m365-copilot": "1.0.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "yaml": "2.9.1"
  }
}
